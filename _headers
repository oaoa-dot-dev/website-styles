# Cloudflare Pages Headers Configuration for styles.oaoa.dev

/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Allow-Headers: *
  X-Content-Type-Options: nosniff

# Immutable long-term cache for versioned assets (/v1/)
/v1/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

# Root and entry HTML (always revalidate immediately on deploy)
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Living root CSS and JS (always revalidate immediately on deploy)
/*.css
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate

/*.js
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate
